#!/usr/bin/env bash
# pre-commit hook for stock-trend skill.
# Set STOCK_TREND_SKIP_GOLDEN=1 only when a documented external blocker exists.

set -o nounset
set -o pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SKILL_DIR="$ROOT_DIR/.claude/skills/stock-trend"
STAGED="$(git -C "$ROOT_DIR" diff --cached --name-only --diff-filter=ACMR)"
SCRIPT_PATTERN='^\.claude/skills/stock-trend/scripts/.+\.py$'
TEMPLATE_PATTERN='^\.claude/skills/stock-trend/assets/report-template\.(md|html)$'
REPORT_SCRIPT='.claude/skills/stock-trend/scripts/reporting/report.py'
SCORES_SCRIPT='.claude/skills/stock-trend/scripts/analysis/scores.py'

has_staged_match() {
    printf '%s\n' "$STAGED" | grep -Eq "$1"
}

fail() {
    echo "✗ $1" >&2
    exit 1
}

check_template_context() {
    local template_file="$SKILL_DIR/assets/report-template.md"
    local report_script="$SKILL_DIR/scripts/reporting/report.py"

    [ -f "$template_file" ] || fail "报告模板缺失: $template_file"
    [ -f "$report_script" ] || fail "报告渲染模块缺失: $report_script"

    local template_vars context_keys missing
    template_vars="$(grep -oE '\{\{[[:alnum:]_]+\}\}' "$template_file" | sed 's/{{//;s/}}//' | sort -u || true)"
    context_keys="$(grep -oE '"[^"]+"[[:space:]]*:' "$report_script" | sed -E 's/^"([^"]+)".*/\1/' | sort -u || true)"
    missing=""
    while IFS= read -r var; do
        [ -z "$var" ] && continue
        case "$var" in
            风险项|内容) continue ;;
        esac
        printf '%s\n' "$context_keys" | grep -Fxq "$var" || missing="$missing $var"
    done <<< "$template_vars"

    if [ -n "$missing" ]; then
        fail "报告模板变量未在 reporting.report 上下文中找到:$missing"
    fi
    echo "✓ 报告模板变量与 reporting.report 上下文匹配"
}

check_scores_schema() {
    local scores_script="$SKILL_DIR/scripts/analysis/scores.py"
    [ -f "$scores_script" ] || fail "评分模块缺失: $scores_script"

    (
        cd "$SKILL_DIR/scripts" || exit 1
        python3 - <<'PY'
from analysis.scores import validate_input

valid = {
    "summary": {"total_score": 5.2, "direction": "bullish", "confidence": 0.7},
    "data_quality": "good",
}
if validate_input(valid, {}):
    raise SystemExit("validate_input rejected valid input")
if not validate_input({"summary": {}}, {}):
    raise SystemExit("validate_input accepted invalid input")
PY
    ) || fail "analysis.scores.validate_input schema 校验失败"
    echo "✓ analysis.scores.validate_input schema 校验通过"
}

if has_staged_match "$TEMPLATE_PATTERN" || has_staged_match "^${REPORT_SCRIPT}$"; then
    echo "检查报告模板变量一致性..."
    check_template_context
fi

if has_staged_match "^${SCORES_SCRIPT}$"; then
    echo "检查评分输入 schema..."
    check_scores_schema
fi

if has_staged_match "$SCRIPT_PATTERN"; then
    echo "运行 Stock Trend 质量门..."
    make -C "$ROOT_DIR" syntax test-unit test-integration
    if [ "${STOCK_TREND_SKIP_GOLDEN:-}" = "1" ]; then
        echo "⚠ Golden diff 已跳过 (STOCK_TREND_SKIP_GOLDEN=1)"
    else
        make -C "$ROOT_DIR" test-golden
    fi
    make -C "$ROOT_DIR" diff-check-staged
else
    echo "✓ 未暂存 Stock Trend Python 变更，跳过质量门"
fi
